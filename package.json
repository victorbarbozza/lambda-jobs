{
  "name": "lambda-jobs",
  "version": "0.1.0",
  "description": "Durable jobs for AWS Lambda on EventBridge Scheduler and DynamoDB, with retries by rescheduling and a watchdog for missed deliveries.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorbarbozza/lambda-jobs.git"
  },
  "bugs": {
    "url": "https://github.com/victorbarbozza/lambda-jobs/issues"
  },
  "homepage": "https://github.com/victorbarbozza/lambda-jobs#readme",
  "keywords": [
    "aws",
    "lambda",
    "eventbridge",
    "scheduler",
    "jobs",
    "cron",
    "retry",
    "dynamodb"
  ],
  "scripts": {
    "build": "bun run clean && bun build:tsc",
    "build:tsc": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "bun typecheck:tsc",
    "typecheck:tsc": "tsc -p tsconfig.typecheck.json",
    "test": "bun scripts/testIsolated.ts __tests__",
    "test:package": "bun scripts/testPackage.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@middy/core": "^7.9.2",
    "@middy/validator": "^7.9.2",
    "@types/aws-lambda": "^8.10.164",
    "dayjs": "^1.11.23",
    "typebox": "^1.3.30"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-scheduler": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1128.0",
    "@aws-sdk/client-scheduler": "^3.1128.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
